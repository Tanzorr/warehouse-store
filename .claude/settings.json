{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "defaultMode": "default",

    "allow": [
      "Read",
      "Glob",
      "Grep",

      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(head:*)",
      "Bash(tail:*)",

      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)",
      "Bash(git grep:*)",
      "Bash(git ls-files:*)",

      "Bash(php artisan test:*)",
      "Bash(php artisan route:list:*)",
      "Bash(php artisan schedule:list:*)",
      "Bash(php artisan config:show:*)",
      "Bash(php artisan about:*)",
      "Bash(php artisan migrate:status:*)",
      "Bash(./vendor/bin/pint:*)",
      "Bash(./vendor/bin/phpstan:*)",
      "Bash(./vendor/bin/psalm:*)",
      "Bash(./vendor/bin/phpunit:*)",
      "Bash(./vendor/bin/deptrac:*)",
      "Bash(composer show:*)",
      "Bash(composer validate:*)",
      "Bash(php bin/phpunit:*)",
      "Bash(php bin/console debug\\:*)",
      "Bash(php bin/console cache\\:clear:*)",
      "Bash(php bin/console doctrine\\:migrations\\:status:*)",

      "Bash(ng test:*)",
      "Bash(ng lint:*)",
      "Bash(ng build:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",

      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose exec app php artisan test:*)",
      "Bash(docker compose exec app php artisan route:list:*)",
      "Bash(docker compose exec app php artisan migrate:status:*)",
      "Bash(docker compose exec app ./vendor/bin/pint:*)",
      "Bash(docker compose exec app php bin/phpunit:*)"
    ],

    "ask": [
      "Bash(composer require:*)",
      "Bash(composer remove:*)",
      "Bash(composer update:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",

      "Bash(php artisan migrate:*)",
      "Bash(php bin/console doctrine\\:migrations\\:migrate:*)",
      "Bash(php bin/console doctrine\\:migrations\\:diff:*)",
      "Bash(docker compose exec app php artisan migrate:*)",
      "Bash(php artisan db:*)",

      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose build:*)",
      "Bash(docker compose restart:*)",
      "Bash(docker volume:*)",

      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git rebase:*)",
      "Bash(git stash:*)",

      "Edit(./shop-2-back/composer.json)",
      "Edit(./shop-2-back/composer.lock)",
      "Edit(./shop-2-back/package.json)",
      "Edit(./warehouses/composer.json)",
      "Edit(./warehouses/composer.lock)",
      "Edit(./shop-front/package.json)",
      "Edit(./*/docker-compose.yml)",
      "Edit(./*/.env.example)"
    ],

    "deny": [
      "Read(./*/.env)",
      "Read(./*/.env.local)",
      "Read(./*/.env.dev)",
      "Read(./*/.env.test)",
      "Read(./*/.env.production)",
      "Read(./*/auth.json)",
      "Read(./shop-2-back/storage/app/**)",
      "Read(./warehouses/var/**)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./**/*.p12)",
      "Read(./**/id_rsa*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",

      "Edit(./*/.env)",
      "Edit(./*/.env.local)",
      "Edit(./*/.env.dev)",
      "Edit(./*/.env.test)",
      "Edit(./*/.env.production)",
      "Edit(./**/vendor/**)",
      "Edit(./**/node_modules/**)",
      "Edit(./shop-2-back/storage/framework/**)",
      "Edit(./warehouses/var/**)",

      "Bash(cat .env)",
      "Bash(cat */.env)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(docker compose down -v:*)",
      "Bash(php artisan migrate:fresh:*)",
      "Bash(php bin/console doctrine\\:database\\:drop:*)",
      "Bash(docker compose exec app php artisan migrate:fresh:*)",
      "Bash(chmod 777:*)"
    ]
  }
}
